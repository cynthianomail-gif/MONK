; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="和尚逆天 Monk Go Rogue"
run/main_scene="res://src/screens/TitleScreen/TitleScreen.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")

[autoload]

EventBus="*res://src/autoloads/EventBus.gd"
GameManager="*res://src/autoloads/GameManager.gd"
SaveManager="*res://src/autoloads/SaveManager.gd"
AudioManager="*res://src/autoloads/AudioManager.tscn"
SceneRouter="*res://src/autoloads/SceneRouter.gd"
QuestManager="*res://src/systems/QuestManager.gd"
BreakVowSystem="*res://src/systems/BreakVowSystem.gd"
SkillUnlockManager="*res://src/systems/SkillUnlockManager.gd"
CultivationBoard="*res://src/autoloads/CultivationBoard.gd"
MainQuestManager="*res://src/systems/MainQuestManager.gd"
AchievementSystem="*res://src/systems/AchievementSystem.gd"
GodIntel="*res://src/systems/GodIntel.gd"
Dialogic="*res://addons/dialogic/Core/DialogicGameHandler.gd"
SettingsManager="*res://src/autoloads/SettingsManager.gd"

[dialogic]

