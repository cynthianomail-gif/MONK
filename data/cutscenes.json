    "captions": [
      {"start": 0.8,  "end": 4.2,  "speaker": "",     "text": "……百年古剎，一夜成墟。"},
      {"start": 5.0,  "end": 8.4,  "speaker": "無戒",   "text": "……不行。那群孽障，我追定了。"},
      {"start": 9.9,  "end": 13.7, "speaker": "阿瑞斯", "text": "就這點能耐，也配當一座廟的主人？", "voice": "ares_scoff"},
      {"start": 14.4, "end": 17.6, "speaker": "阿瑞斯", "text": "醒醒吧，和尚。神，回來了——這城裡每一份信仰，", "voice": "ares_laugh"},
      {"start": 17.7, "end": 20.2, "speaker": "阿瑞斯", "text": "從今天起，全是萬神殿的資產。"},
      {"start": 20.8, "end": 22.7, "speaker": "阿瑞斯", "text": "連舍利塔都守不住，還談什麼戒律。", "voice": "ares_hey"},
      {"start": 28.3, "end": 30.7, "speaker": "無戒",   "text": "戒律……是用來律己的。"},
      {"start": 30.9, "end": 32.9, "speaker": "無戒",   "text": "不是任你們踐踏的。"},
      {"start": 33.1, "end": 34.6, "speaker": "無戒",   "text": "我會把你們……全部，"},
      {"start": 34.7, "end": 37.6, "speaker": "無戒",   "text": "驅.逐.出.去.", "cps": 3.0, "trigger_faint": true, "faint_sfx": "body_collapse"}
    ]
